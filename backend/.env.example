# --- Konfiguracja backendu Zdrovia ---

# Port serwera API
PORT=4000

# Sekret do podpisywania tokenów JWT (USTAW WŁASNY, długi i losowy!)
JWT_SECRET=zmien-mnie-na-dlugi-losowy-sekret

# Czas ważności access tokenu
JWT_EXPIRES_IN=2h

# Ścieżka pliku bazy SQLite (relatywna do /backend)
DATABASE_URL=./data/zdrovia.db

# Adres frontendu (dla CORS). Wiele adresów oddziel przecinkiem.
CLIENT_ORIGIN=http://localhost:8123,http://127.0.0.1:8123,http://localhost:4000

# Tryb pracy (development | production)
NODE_ENV=development

# AI Triage — webhook workflow n8n (backend jest proxy; frontend NIGDY nie łączy się z n8n).
# Do testów bez n8n można wskazać lokalną atrapę: http://localhost:4000/api/_mock-n8n
N8N_WEBHOOK_URL=https://twoje-n8n.example.com/webhook/triage
# Sekret wysyłany w nagłówku X-Webhook-Secret; n8n musi go weryfikować.
N8N_WEBHOOK_SECRET=zmien-na-dlugi-losowy-sekret

# Konto administratora — tworzone skryptem `npm run seed:admin` (NIE przez rejestrację).
ADMIN_EMAIL=admin@zdrovia.pl
ADMIN_PASSWORD=zmien-na-silne-haslo

# Klucz szyfrowania sekretów konfiguracyjnych (SMTP itd.) — WYMAGANY, serwer bez niego nie startuje.
# 32 bajty w hex. Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# W produkcji trzymaj w menadżerze sekretów hostingu. Utrata klucza = nieodwracalna utrata sekretów w bazie.
ENCRYPTION_KEY=
