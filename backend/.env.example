# --- Konfiguracja backendu Zdrovia ---

# Port serwera API. Na serwerze produkcyjnym: 45003
# (45002 jest zarezerwowany przez HTTP.sys dla IIS — Node dostanie EACCES).
PORT=4000

# Interfejs nasłuchu. 0.0.0.0 = wszystkie; 127.0.0.1 = tylko lokalnie.
HOST=0.0.0.0

# Sekret do podpisywania tokenów JWT (USTAW WŁASNY, długi i losowy!)
JWT_SECRET=zmien-mnie-na-dlugi-losowy-sekret

# Czas ważności access tokenu
JWT_EXPIRES_IN=2h

# Ścieżka pliku bazy SQLite (relatywna do /backend)
DATABASE_URL=./data/zdrovia.db

# Adresy frontendu dopuszczone przez CORS. Wiele adresów oddziel przecinkiem.
# WAŻNE: podaje się sam origin (schemat + host + port), BEZ ścieżki —
# dla GitHub Pages jest to https://<uzytkownik>.github.io, a nie .../zdrovia/
CLIENT_ORIGIN=http://localhost:8123,http://127.0.0.1:8123,http://localhost:4000

# Tryb pracy (development | production)
NODE_ENV=development

# --- HTTPS ---------------------------------------------------------------
# Wymagane, gdy frontend stoi na osobnym hoście po HTTPS (GitHub Pages):
# strona z https:// nie wykona żądania do http:// (mixed content).
# Wariant A — PFX/PKCS#12 (wygodny na Windows, eksport z magazynu certyfikatów):
#SSL_PFX_FILE=C:/certs/zdrovia.pfx
#SSL_PFX_PASSPHRASE=haslo-do-pliku-pfx
# Wariant B — para plików PEM:
#SSL_CERT_FILE=/etc/ssl/certs/zdrovia.crt
#SSL_KEY_FILE=/etc/ssl/private/zdrovia.key
# Pominięcie obu wariantów = serwer startuje po HTTP (tylko do developmentu).

# Publiczny adres API — musi zgadzać się z nazwą w certyfikacie
# (nie localhost i nie gołe IP). Używany w logu startowym.
#PUBLIC_APP_URL=https://twoj-host.example.pl:45003

# Publiczny adres frontendu — używany w linkach w e-mailach.
# Dla GitHub Pages zawiera nazwę repozytorium.
#PUBLIC_FRONTEND_URL=https://uzytkownik.github.io/zdrovia

# Polityka SameSite ciasteczka z tokenem: lax (zalecane) | none | strict.
# "none" pozwala wysyłać ciasteczko cross-site, ale WYMAGA HTTPS i znosi
# wbudowaną ochronę CSRF — przy froncie na innym hoście zostaw "lax"
# i polegaj na nagłówku Authorization: Bearer.
COOKIE_SAMESITE=lax

# --- AI Triage (n8n) -----------------------------------------------------
# Backend jest proxy; frontend NIGDY nie łączy się z n8n bezpośrednio.
# Gdy n8n działa na tej samej maszynie, zostaw adres pętli zwrotnej —
# ruch nie opuszcza serwera i n8n nie musi być wystawiony publicznie.
# Do testów bez n8n można wskazać atrapę: http://localhost:4000/api/_mock-n8n
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/triage
# Sekret wysyłany w nagłówku X-Webhook-Secret; n8n musi go weryfikować.
N8N_WEBHOOK_SECRET=zmien-na-dlugi-losowy-sekret

# --- Konto administratora ------------------------------------------------
# Tworzone skryptem `npm run seed:admin` (NIE przez rejestrację).
ADMIN_EMAIL=admin@zdrovia.pl
ADMIN_PASSWORD=zmien-na-silne-haslo

# Klucz szyfrowania sekretów konfiguracyjnych (SMTP itd.) — WYMAGANY, serwer bez niego nie startuje.
# 32 bajty w hex. Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# W produkcji trzymaj w menadżerze sekretów hostingu. Utrata klucza = nieodwracalna utrata sekretów w bazie.
ENCRYPTION_KEY=
